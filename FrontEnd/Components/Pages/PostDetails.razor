@page "/posts/{Id:int}"
@using ApiContracts
@using FrontEnd.HttpServices
@using System.Security.Claims
@inject IPostService PostService
@inject IUserService UserService
@inject ICommentService CommentService

<PageTitle>Post details</PageTitle>

<p>
    <a href="/posts">← Back to posts</a>
</p>

@if (_loading)
{
    <p>Loading post...</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <p class="text-danger">@_error</p>
}
else if (_post is not null)
{
    <h1>@_post.Title</h1>

    <p><strong>Author:</strong> @_authorName</p>

    <hr />

    <h3>Content</h3>
    <p style="white-space: pre-wrap">@_post.Body</p>

    <hr />

    <h2>Comments (@_comments.Count)</h2>

    @if (_comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        @foreach (CommentDto comment in _comments)
        {
            <div class="card mb-2" @key="comment.Id">
                <div class="card-body">
                    <p style="white-space: pre-wrap">@comment.Body</p>
                    <small>By @GetCommentAuthor(comment.UserId)</small>
                </div>
            </div>
        }
    }

    <h3 class="mt-4">Add comment</h3>

    @if (_activeUserId == 0)
    {
        <p class="text-warning">
            Please <a href="/login">log in</a> to add a comment.
        </p>
    }
    else
    {
        <p>Commenting as: @_activeUserName</p>

        <div class="mb-3">
            <label for="commentText" class="form-label">Comment</label>
            <textarea id="commentText"
                      class="form-control"
                      @bind="_commentText"
                      @bind:event="oninput"
                      rows="4"></textarea>
        </div>

        <button class="btn btn-primary"
                type="button"
                disabled="@_submitting"
                @onclick="AddCommentAsync">
            @(_submitting ? "Adding..." : "Add comment")
        </button>
    }

    @if (!string.IsNullOrWhiteSpace(_commentMessage))
    {
        <p class="mt-3">@_commentMessage</p>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private PostDto? _post;
    private List<CommentDto> _comments = new();
    private List<UserDto> _users = new();

    private string _authorName = "";
    private string _activeUserName = "";
    private string _commentText = "";
    private string _error = "";
    private string _commentMessage = "";

    private int _activeUserId;
    private bool _loading = true;
    private bool _submitting;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = "";
        _commentMessage = "";

        try
        {
            _post = await PostService.GetPostAsync(Id);
            _users = await UserService.GetUsersAsync();
            _comments = (await CommentService.GetCommentsForPostAsync(Id))
                .Where(c => !string.IsNullOrWhiteSpace(c.Body))
                .ToList();

            _authorName = FindUserName(_post.UserId);

            AuthenticationState authState = await AuthenticationStateTask;
            ClaimsPrincipal currentUser = authState.User;
            string? idValue = currentUser.FindFirst("Id")?.Value;

            if (currentUser.Identity?.IsAuthenticated == true &&
                int.TryParse(idValue, out int authenticatedUserId))
            {
                _activeUserId = authenticatedUserId;
                _activeUserName = currentUser.Identity.Name ?? "";
            }
            else
            {
                _activeUserId = 0;
                _activeUserName = "";
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not load post: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string FindUserName(int userId)
    {
        return _users.FirstOrDefault(u => u.Id == userId)?.UserName
               is { Length: > 0 } name
            ? name
            : $"User #{userId}";
    }

    private string GetCommentAuthor(int userId)
    {
        return FindUserName(userId);
    }

    private async Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_commentText))
        {
            _commentMessage = "Please enter a comment.";
            return;
        }

        if (_activeUserId == 0)
        {
            _commentMessage = "Please log in before commenting.";
            return;
        }

        _submitting = true;
        _commentMessage = "";

        try
        {
            CreateCommentDto request = new()
            {
                Body = _commentText.Trim(),
                PostId = Id,
                UserId = _activeUserId
            };

            await CommentService.AddCommentAsync(request);

            _comments = (await CommentService.GetCommentsForPostAsync(Id))
                .Where(c => !string.IsNullOrWhiteSpace(c.Body))
                .ToList();
            _commentText = "";
            _commentMessage = "Comment added successfully.";
        }
        catch (Exception ex)
        {
            _commentMessage = $"Could not add comment: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }
}

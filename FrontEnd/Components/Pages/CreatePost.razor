@page "/posts/create"
@attribute [Authorize]
@using ApiContracts
@using FrontEnd.HttpServices
@using System.Security.Claims
@inject IPostService PostService
@inject NavigationManager Navigation

<PageTitle>Create post</PageTitle>

<h1>Create post</h1>
<p>Creating post as: <strong>@_activeUserName</strong></p>

<EditForm Model="_request" OnValidSubmit="CreateAsync" FormName="CreatePostForm">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label for="postTitle" class="form-label">Title</label>
        <InputText id="postTitle" class="form-control" @bind-Value="_request.Title" />
    </div>
    <div class="mb-3">
        <label for="postBody" class="form-label">Body</label>
        <InputTextArea id="postBody" class="form-control" @bind-Value="_request.Body" />
    </div>
    <button class="btn btn-primary" type="submit" disabled="@_submitting">
        @(_submitting ? "Creating..." : "Create post")
    </button>
    <a href="/posts" class="btn btn-secondary ms-2">Cancel</a>
</EditForm>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <p class="text-danger mt-3">@_error</p>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private CreatePostDto _request = new() { Title = "", Body = "", UserId = 0 };
    private int _activeUserId;
    private string _activeUserName = "";
    private string _error = "";
    private bool _submitting;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateTask;
        ClaimsPrincipal user = state.User;
        string? idValue = user.FindFirst("Id")?.Value;
        if (user.Identity?.IsAuthenticated != true ||
            !int.TryParse(idValue, out _activeUserId))
        {
            _error = "Could not identify the logged-in user. Please log in again.";
            return;
        }
        _activeUserName = user.Identity.Name ?? "User";
    }

    private async Task CreateAsync()
    {
        if (_activeUserId <= 0)
        {
            _error = "You must be logged in to create a post.";
            return;
        }

        _submitting = true;
        _error = "";
        try
        {
            _request.UserId = _activeUserId;
            PostDto post = await PostService.AddPostAsync(_request);
            Navigation.NavigateTo($"/posts/{post.Id}");
        }
        catch (Exception ex)
        {
            _error = $"Could not create post: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }
}
